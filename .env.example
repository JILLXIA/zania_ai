OPENAI_API_KEY=
# Optional LangSmith observability. Disabled unless explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zania-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
# Set BOTH to false only when you approve sending source content to LangSmith.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
ZANIA_MODEL_CACHE=.models
# Bounds can be overridden using ZANIA_ prefixed settings (see README).
ZANIA_MAX_DOCUMENT_BYTES=20971520
ZANIA_MAX_QUESTIONS=30
ZANIA_MAX_VISUAL_PAGES=10
ZANIA_PROCESSING_TIMEOUT=180
